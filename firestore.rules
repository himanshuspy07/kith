rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Kith Chat Application Security Rules
     * Optimized for performance, real-time synchronization, and security.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRoomMember(chatRoomId) {
      return isSignedIn() && 
             get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.members[request.auth.uid] == true;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Users shouldn't delete themselves easily
    }

    match /chatRooms/{chatRoomId} {
      allow list: if isSignedIn() && resource.data.members[request.auth.uid] == true;
      allow get: if isSignedIn() && (
        resource == null || resource.data.members[request.auth.uid] == true
      );
      allow create: if isSignedIn() && request.resource.data.members[request.auth.uid] == true;
      allow update: if isSignedIn() && resource.data.members[request.auth.uid] == true;
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow list, get: if isRoomMember(chatRoomId);
        allow create: if isRoomMember(chatRoomId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isRoomMember(chatRoomId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['readBy', 'reactions', 'openedBy'])
        );
        allow delete: if isRoomMember(chatRoomId) && resource.data.senderId == request.auth.uid;
      }
    }

    // --- Calling Rules ---
    match /calls/{callId} {
      allow create: if isSignedIn();
      allow list: if isSignedIn();
      // Allow if user is caller or receiver
      allow get, update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.callerId || 
        request.auth.uid == resource.data.receiverId
      );

      match /callerCandidates/{id} {
        allow read, write: if isSignedIn();
      }
      match /receiverCandidates/{id} {
        allow read, write: if isSignedIn();
      }
    }
  }
}